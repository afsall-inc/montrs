# MontRS Server Configuration
# ───────────────────────────────
# These variables are set automatically by `montrs serve` and `montrs watch`.
# Override them for production deployments or custom setups.

# Address the SSR server binds to (default: 127.0.0.1:3000)
MONTRS_SITE_ADDR=127.0.0.1:3000

# Static assets + WASM output directory, relative to project root (default: target/site)
MONTRS_SITE_ROOT=target/site

# WASM package subdirectory inside MONTRS_SITE_ROOT (default: pkg)
MONTRS_SITE_PKG_DIR=pkg
