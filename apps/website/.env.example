# MontRS Server Configuration
# ───────────────────────────────
# These variables are set automatically by `montrs serve` and `montrs watch`.
# Override them for production deployments.

# Address the SSR server binds to.
# Format: HOST:PORT (default: 127.0.0.1:3000)
MONTRS_SITE_ADDR=127.0.0.1:3000

# Directory containing the built site: static assets, WASM package, and index.html.
# Relative to the project root (default: target/site)
MONTRS_SITE_ROOT=target/site

# Subdirectory inside MONTRS_SITE_ROOT where the WASM package lives.
# This is where wasm-bindgen outputs the .wasm and .js files (default: pkg)
MONTRS_SITE_PKG_DIR=pkg
